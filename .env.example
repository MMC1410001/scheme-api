# Scheme API settings template. The only settings file in git; real values never are.
#
# One real file per environment, next to this one (all ignored by git):
#   .env.local   your machine (default)          APP_ENV=local
#   .env.dev     Dev                              APP_ENV=dev
#   .env.uat     UAT                              APP_ENV=uat
#   .env.prod    Production                       APP_ENV=prod
# Copy this file to the one you need and fill it in. The app reads .env.$APP_ENV (APP_ENV defaults
# to local); environment variables always win over the file, so a platform can set them directly.
# Values marked [dev/uat/prod] are what changes per environment.

# --- Database ---
# local: the Docker Postgres below. [dev] the teammate's shared app_db (team VPN only);
# [uat/prod] from DevOps.
DATABASE_URL=postgresql://acme:acme@localhost:5433/acme
# Connections per worker process (total = workers x DB_POOL_MAX)
DB_POOL_MAX=10

# --- API access: OAuth2 client credentials + JWT (app/security.py) ---
# Callers POST client_id + client_secret to /v1/auth/token, get a Bearer token valid for
# JWT_TTL_SECONDS, and send `Authorization: Bearer <token>` on every /v1/schemes call.
# Outside APP_ENV=local the API refuses to start unless AUTH_CLIENTS and JWT_SECRET are set and valid.
# local: client "local-client" / secret "local-test-secret" (matches the Postman "Local" environment);
# delete AUTH_CLIENTS and JWT_SECRET and start with APP_ENV=local set explicitly to run locally without
# auth (with APP_ENV unset and no auth settings the API refuses to start).
# [dev/uat/prod] per environment, never reused:
#   python -m app.security new-client partner     -> give client_id + client_secret to the client securely,
#                                                put the printed hash entry in AUTH_CLIENTS
#   python -m app.security new-jwt-secret     -> JWT_SECRET
# AUTH_CLIENTS holds only SHA-256 hashes of the secrets, as JSON: {"partner": "<hash>", "qa": "<hash>"}.
# Removing a client revokes its tokens at once. Rotate JWT_SECRET by moving the old value to
# JWT_PREVIOUS_SECRET for one JWT_TTL_SECONDS, then deleting it.
AUTH_CLIENTS={"local-client": "0b1f90b824765bd860b58a3ebc0396a4f6f4c4ad8f1eed10135c0cb6cf3bd171"}
JWT_SECRET=local-only-jwt-signing-key-not-for-servers-0001
# JWT_PREVIOUS_SECRET=
JWT_TTL_SECONDS=3600
# Interactive docs at /docs and /openapi.json. [prod] false.
DOCS_ENABLED=true

# --- Redis response cache (for the dealer app's peak: up to 1 lakh requests a minute) ---
# On only when CACHE_ENABLED=true and REDIS_URL is set; the cron job needs the same two values.
# local: docker compose up -d redis, then CACHE_ENABLED=true. [dev] false. [uat/prod] true, with
# that environment's Redis (from DevOps).
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Longest a cached response lives (seconds); new data replaces it sooner.
CACHE_TTL_SECONDS=900

# --- Per-IP rate limit (app/ratelimit.py) ---
# Requests per second from one client IP before 429 + Retry-After. 2500/s (1.5 lakh a minute) is
# above the dealer app's busiest load (1 lakh a minute) even from a single the client server. Counted in
# Redis when REDIS_URL is set (exact across workers), else per worker.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=2500
# POST /v1/auth/token per client IP per minute (a client needs one token an hour).
TOKEN_RATE_LIMIT_PER_MINUTE=30
# Behind nginx/a load balancer: its address(es), IPs or CIDRs separated by commas, so the caller's IP
# is taken from X-Forwarded-For (right-most entry that is not a trusted proxy). Empty: the header is
# ignored. Start the API with `python -m app` (uvicorn's own X-Forwarded-For handling off).
TRUSTED_PROXIES=

# --- Where the files come from (cron job only; the API never reads GCS) ---
# local: read sample files from this folder. [dev/uat/prod] empty = read from GCS.
LOCAL_DATA_DIR=local_data
GCS_BUCKET=acme-scheme-files
# Optional: Google Cloud project ID for the GCS client (reading the bucket works without it)
GCS_PROJECT=
# [dev/uat/prod] service-account key file mounted on the server (from the GCS owner). Not needed
# when the server runs as a service account that can read the bucket, or on a laptop after
# `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-service-account.json

# GCS folder of a month's SAP exports, e.g. acme-scheme-files/sap-exports/2026/10.
# The job fills in the month it loads (default: the current month, India time);
# January-September are tried as "01" first, then "1".
SCHEME_PREFIX_TEMPLATE=sap-exports/{year}/{month:02d}/
SCHEME_HEADER_ROWS=1
# Files downloaded and parsed in parallel while the current one is saved.
LOADER_WORKERS=4
# The API runs the loader itself (app/scheduler.py). Empty: on everywhere except APP_ENV=local.
# Set false only if a cron job runs `python -m ingestion.run schemes` instead.
LOADER_SCHEDULE_ENABLED=
# Daily run time, HH:MM in TIMEZONE (India time). SAP's files land around 04:30-05:00.
LOADER_DAILY_AT=09:00
# A failed run is tried again this many times, this many minutes apart.
LOADER_RETRIES=3
LOADER_RETRY_MINUTES=30
# A run taking longer is stopped (counts as failed; the retry carries on).
LOADER_TIMEOUT_MINUTES=120
# On days 1-3 of a month the previous month is loaded too.
LOADER_CATCH_UP_DAYS=3

