# Scheme API settings template. The only settings file in git; real values never are.
#
# One real file per environment, next to this one (all ignored by git):
#   .env.local   your machine (default)          APP_ENV=local
#   .env.dev     Dev                              APP_ENV=dev
#   .env.uat     UAT                              APP_ENV=uat
#   .env.prod    Production                       APP_ENV=prod
# Copy this file to the one you need and fill it in. The app reads .env.$APP_ENV (APP_ENV defaults
# to local); environment variables always win over the file, so a platform can set them directly.
# Values marked [dev/uat/prod] are what changes per environment.

# --- Database ---
# local: the Docker Postgres below. [dev] the teammate's shared app_db (team VPN only);
# [uat/prod] from DevOps.
DATABASE_URL=postgresql://acme:acme@localhost:5433/acme
# Connections per worker process (total = workers x DB_POOL_MAX)
DB_POOL_MAX=10

# --- API access ---
# Callers send this value in the X-API-Key header. Remove the line to turn auth off (then set
# authEnabled=false in Postman).
# local: local-test-key, which matches the Postman "Local" environment.
# [dev/uat/prod] a separate long random secret each:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=local-test-key
# Interactive docs at /docs and /openapi.json. [prod] false.
DOCS_ENABLED=true

# --- Redis response cache (for the dealer app's peak: up to 1 lakh requests a minute) ---
# On only when CACHE_ENABLED=true and REDIS_URL is set; the cron job needs the same two values.
# local: docker compose up -d redis, then CACHE_ENABLED=true. [dev] false. [uat/prod] true, with
# that environment's Redis (from DevOps).
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Longest a cached response lives (seconds); new data replaces it sooner.
CACHE_TTL_SECONDS=900

# --- Where the files come from (cron job only; the API never reads GCS) ---
# local: read sample files from this folder. [dev/uat/prod] empty = read from GCS.
LOCAL_DATA_DIR=local_data
GCS_BUCKET=acme-scheme-files
# Optional: Google Cloud project ID for the GCS client (reading the bucket works without it)
GCS_PROJECT=
# [dev/uat/prod] service-account key file mounted on the server (from the GCS owner). Not needed
# when the server runs as a service account that can read the bucket, or on a laptop after
# `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-service-account.json

# GCS folder of a month's SAP exports, e.g. acme-scheme-files/sap-exports/2026/10.
# The job fills in the month it loads (default: the current month, India time);
# January-September are tried as "01" first, then "1".
SCHEME_PREFIX_TEMPLATE=sap-exports/{year}/{month:02d}/
SCHEME_HEADER_ROWS=1
# Files downloaded and parsed in parallel while the current one is saved.
LOADER_WORKERS=4

# --- API 2 (on hold; kept for when it resumes) ---
# Generated reports, one folder per month: automated-generated-files/output/2024/01/..._grouped_v1.xlsx
REPORT_PREFIX=automated-generated-files/output/
REPORT_HEADER_ROWS=2
REPORT_DEALER_COLUMN=customer
