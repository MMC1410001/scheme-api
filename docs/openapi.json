{
  "openapi": "3.1.0",
  "info": {
    "title": "Scheme API",
    "description": "Scheme data (from SAP files in GCS) for the client team.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Get an access token (OAuth2 client credentials)",
        "description": "Exchange client_id and client_secret for a Bearer token valid for 1 hour.\n\nSend `grant_type=client_credentials` form-encoded (RFC 6749) or as JSON, with the client's\ncredentials in HTTP Basic auth or as `client_id` and `client_secret` in the body (not both).\nReuse the token until it expires; this endpoint has its own, much lower, rate limit.",
        "operationId": "token_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "client_credentials"
                    ]
                  },
                  "client_id": {
                    "type": "string",
                    "description": "Omit when sent with HTTP Basic auth"
                  },
                  "client_secret": {
                    "type": "string",
                    "format": "password",
                    "description": "Omit when sent with HTTP Basic auth"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "schemes:read"
                    ],
                    "description": "Optional; the only scope"
                  }
                },
                "type": "object",
                "required": [
                  "grant_type"
                ]
              }
            },
            "application/json": {
              "schema": {
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "client_credentials"
                    ]
                  },
                  "client_id": {
                    "type": "string",
                    "description": "Omit when sent with HTTP Basic auth"
                  },
                  "client_secret": {
                    "type": "string",
                    "format": "password",
                    "description": "Omit when sent with HTTP Basic auth"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "schemes:read"
                    ],
                    "description": "Optional; the only scope"
                  }
                },
                "type": "object",
                "required": [
                  "grant_type"
                ]
              },
              "example": {
                "grant_type": "client_credentials",
                "client_id": "partner",
                "client_secret": "<client secret>"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Access token; reuse it until expires_in seconds have passed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "access_token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "token_type": "Bearer",
                  "expires_in": 3600,
                  "scope": "schemes:read"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request, wrong grant_type or scope (RFC 6749 errors)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorResponse"
                },
                "example": {
                  "error": "unsupported_grant_type",
                  "error_description": "Only client_credentials is supported"
                }
              }
            }
          },
          "401": {
            "description": "Unknown client or wrong secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthErrorResponse"
                },
                "example": {
                  "error": "invalid_client",
                  "error_description": "Client authentication failed"
                }
              }
            }
          },
          "413": {
            "description": "Request body larger than MAX_BODY_BYTES",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Request body too large"
                }
              }
            }
          },
          "429": {
            "description": "More than TOKEN_RATE_LIMIT_PER_MINUTE token requests from this IP in a minute",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Too many requests"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error; details are logged, not returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Internal server error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schemes/current-month": {
      "post": {
        "tags": [
          "schemes"
        ],
        "summary": "API 1: a dealer's scheme rows for the requested month",
        "description": "The dealer's scheme rows for the given month and year: every component SAP sends (EB SLAB 1-3,\nVALUE, VALUE %, VALUE FA, LUXURY, PREMIUM 01/02, EB FULL MONTH and the others), ordered by\nClearCut, highest first (empty ClearCut last). Rows with the same ClearCut keep the API template's\norder: by end date, then the 10 in template order, then other components by name.\n\nA row belongs to every month its validity period overlaps (rows without dates: the GCS month\nfolder its file came from). Each component comes back once per start date: SAP's newest update,\neven if SAP changed the end date or re-issued the scheme under a new agreement number.\nOnly the current month and the two before it are kept; older months return an empty list.\nReturns an empty list when the dealer has no data for that month.\n\nQualification is GSR for EB (EB SLAB 1-3; EB FULL MONTH takes GSR (B)), Value (VALUE, VALUE %,\nVALUE FA), ROLLER, SANDPAPER and MASKING TAPE, and invoiced quantity (Q) for every other component.\nRows of components outside the 10 also carry QualificationBasis (\"GSR\" or \"INVOICE_QTY\", what\nQualification holds) and InvoicedQty (Invoiced Quantity (Q)); rows of the 10 have neither.",
        "operationId": "month_schemes_v1_schemes_current_month_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemeMonthRequest"
              },
              "examples": {
                "valid": {
                  "summary": "Dealer and month",
                  "value": {
                    "dealer_code": "6100000001",
                    "month": 10,
                    "year": 2026
                  }
                },
                "numbers_as_strings": {
                  "summary": "Dealer code as a number, month and year as strings",
                  "value": {
                    "dealer_code": 6100000001,
                    "month": "10",
                    "year": "2026"
                  }
                },
                "leading_zeros": {
                  "summary": "Leading zeros and spaces are ignored",
                  "value": {
                    "dealer_code": "  0006100000001 ",
                    "month": 10,
                    "year": 2026
                  }
                },
                "invalid_month": {
                  "summary": "Month 13 (422)",
                  "value": {
                    "dealer_code": "6100000001",
                    "month": 13,
                    "year": 2026
                  }
                },
                "invalid_missing_year": {
                  "summary": "Year missing (422)",
                  "value": {
                    "dealer_code": "6100000001",
                    "month": 10
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The dealer's rows (empty list when there are none)",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SchemeRow"
                  },
                  "type": "array",
                  "title": "Response Month Schemes V1 Schemes Current Month Post"
                },
                "examples": {
                  "rows": {
                    "summary": "Dealer with data, by ClearCut highest first (3 of the 10 components and two others shown)",
                    "value": [
                      {
                        "Customer": "6100000001",
                        "FromDate": "2026-10-01",
                        "ToDate": "2026-10-31",
                        "ComponentDescription": "ROLLER",
                        "Qualification": 11350.0,
                        "GsrB": 11350.0,
                        "RebateRate": 26.0,
                        "ClearCut": 2951.0,
                        "ShortfallAmount": 0.0,
                        "ShortfallPct": 0.0,
                        "NextSlabRate": 0.0,
                        "QualificationBasis": "GSR",
                        "InvoicedQty": 50.0
                      },
                      {
                        "Customer": "6100000001",
                        "FromDate": "2026-10-01",
                        "ToDate": "2026-10-31",
                        "ComponentDescription": "LUXURY",
                        "Qualification": 315.1,
                        "GsrB": 159292.8,
                        "RebateRate": 1.0,
                        "ClearCut": 1592.93,
                        "ShortfallAmount": 84.9,
                        "ShortfallPct": 21.23,
                        "NextSlabRate": 1.5
                      },
                      {
                        "Customer": "6100000001",
                        "FromDate": "2026-10-01",
                        "ToDate": "2026-10-11",
                        "ComponentDescription": "EB SLAB 1",
                        "Qualification": 405232.86,
                        "GsrB": 405232.86,
                        "RebateRate": 0.75,
                        "ClearCut": 0.0,
                        "ShortfallAmount": 0.0,
                        "ShortfallPct": 0.0,
                        "NextSlabRate": 1.0
                      },
                      {
                        "Customer": "6100000001",
                        "FromDate": "2026-10-01",
                        "ToDate": "2026-10-31",
                        "ComponentDescription": "EB FULL MONTH",
                        "Qualification": 405232.86,
                        "GsrB": 405232.86,
                        "RebateRate": 2.25,
                        "ClearCut": 0.0,
                        "ShortfallAmount": 0.0,
                        "ShortfallPct": 0.0,
                        "NextSlabRate": 0.0
                      },
                      {
                        "Customer": "6100000001",
                        "FromDate": "2026-10-01",
                        "ToDate": "2026-10-31",
                        "ComponentDescription": "ALWD EB2",
                        "Qualification": 12.5,
                        "GsrB": 405232.86,
                        "RebateRate": 1.0,
                        "ClearCut": 0.0,
                        "ShortfallAmount": 0.0,
                        "ShortfallPct": 0.0,
                        "NextSlabRate": 0.0,
                        "QualificationBasis": "INVOICE_QTY",
                        "InvoicedQty": 12.5
                      }
                    ]
                  },
                  "empty": {
                    "summary": "No data for this dealer or month",
                    "value": []
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bearer token missing, invalid or expired (get a new one from /v1/auth/token)",
            "headers": {
              "WWW-Authenticate": {
                "description": "RFC 6750 challenge",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Token expired"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the schemes:read scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Insufficient scope"
                }
              }
            }
          },
          "413": {
            "description": "Request body larger than MAX_BODY_BYTES",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Request body too large"
                }
              }
            }
          },
          "422": {
            "description": "The body failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "detail": [
                    {
                      "loc": [
                        "body",
                        "dealer_code"
                      ],
                      "msg": "Field required",
                      "type": "missing"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "More than RATE_LIMIT_PER_SECOND requests from this IP in one second; retry after Retry-After",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Too many requests"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error; details are logged, not returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Internal server error"
                }
              }
            }
          },
          "503": {
            "description": "No free database connection; retry after the Retry-After seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                },
                "example": {
                  "detail": "Service busy, please retry"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2ClientCredentials": [
              "schemes:read"
            ]
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "The API is up and its database answers",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "ok": true
                }
              }
            }
          },
          "503": {
            "description": "The database did not answer within 2 seconds",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "example": {
                  "ok": false,
                  "detail": "Database unreachable"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorMessage": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorMessage",
        "description": "Body of 401, 403, 413, 429, 500 and 503 responses."
      },
      "OAuthErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "error_description": {
            "type": "string",
            "title": "Error Description"
          }
        },
        "type": "object",
        "required": [
          "error",
          "error_description"
        ],
        "title": "OAuthErrorResponse",
        "description": "RFC 6749 section 5.2 error from the token endpoint."
      },
      "SchemeMonthRequest": {
        "properties": {
          "dealer_code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]+$",
            "title": "Dealer Code",
            "description": "SAP customer code; letters and digits only. Leading zeros are ignored.",
            "examples": [
              "6100000001"
            ]
          },
          "month": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "description": "1-12 (9 or 09)",
            "examples": [
              10
            ]
          },
          "year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Year",
            "description": "Four-digit year, 2000-2100",
            "examples": [
              2026
            ]
          }
        },
        "type": "object",
        "required": [
          "dealer_code",
          "month",
          "year"
        ],
        "title": "SchemeMonthRequest",
        "description": "API 1 body: the dealer and the month to return. Month is 1-12, sent as 9 or 09 (number or string); year is four digits, 2000-2100 (number or string)."
      },
      "SchemeRow": {
        "properties": {
          "Customer": {
            "type": "string",
            "title": "Customer"
          },
          "FromDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fromdate"
          },
          "ToDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Todate"
          },
          "ComponentDescription": {
            "type": "string",
            "title": "Componentdescription",
            "description": "SAP Comp desc: the 10 template components first, then any other component SAP sends",
            "examples": [
              "EB SLAB 1"
            ]
          },
          "Qualification": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qualification",
            "description": "GSR (Q) for EB, Value (VALUE, VALUE %, VALUE FA), ROLLER, SANDPAPER and MASKING TAPE (for EB FULL MONTH, GSR (B)); invoiced quantity (Q) for every other component"
          },
          "GsrB": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gsrb"
          },
          "RebateRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rebaterate"
          },
          "ClearCut": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clearcut"
          },
          "ShortfallAmount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shortfallamount"
          },
          "ShortfallPct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shortfallpct"
          },
          "NextSlabRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nextslabrate",
            "description": "Rebate rate of the next slab (SAP Next Slab Rate)"
          },
          "QualificationBasis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Qualificationbasis",
            "description": "Only for components outside the 10 template ones: what Qualification holds, GSR (GSR (Q); ROLLER, SANDPAPER, MASKING TAPE) or INVOICE_QTY (invoiced quantity (Q); the others). Not sent for the 10.",
            "examples": [
              "INVOICE_QTY"
            ]
          },
          "InvoicedQty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoicedqty",
            "description": "Only for components outside the 10 template ones: SAP Invoiced Quantity (Q) (equal to Qualification when QualificationBasis is INVOICE_QTY). Not sent for the 10.",
            "examples": [
              50.0
            ]
          }
        },
        "type": "object",
        "required": [
          "Customer",
          "FromDate",
          "ToDate",
          "ComponentDescription",
          "Qualification",
          "GsrB",
          "RebateRate",
          "ClearCut",
          "ShortfallAmount",
          "ShortfallPct",
          "NextSlabRate"
        ],
        "title": "SchemeRow",
        "description": "One component row, with the columns of the API template. Keys are PascalCase, like the other dealer APIs."
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "scope": {
            "type": "string",
            "title": "Scope"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "scope"
        ],
        "title": "TokenResponse",
        "description": "RFC 6749 section 5.1 access token response."
      },
      "ValidationErrorResponse": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ValidationErrorResponse",
        "description": "Body of a 422: where and why the request failed. The caller's input is not echoed back."
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc",
            "examples": [
              [
                "body",
                "month"
              ]
            ]
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "examples": [
              "Input should be less than or equal to 12"
            ]
          },
          "type": {
            "type": "string",
            "title": "Type",
            "examples": [
              "less_than_equal"
            ]
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue"
      }
    },
    "securitySchemes": {
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "Get a token from POST /v1/auth/token with your client_id and client_secret, then send `Authorization: Bearer <token>`. Tokens last 1 hour; reuse one until it expires.",
        "flows": {
          "clientCredentials": {
            "scopes": {
              "schemes:read": "Read dealer scheme rows"
            },
            "tokenUrl": "/v1/auth/token"
          }
        }
      }
    }
  }
}
