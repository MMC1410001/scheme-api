    {
      "name": "4. Security",
      "item": [
        {
          "name": "No API key -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/schemes/current-month",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "schemes",
                "current-month"
              ]
            },
            "description": "Only when the server has API_KEY set.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealer_code\": \"{{dealerCode}}\",\n  \"month\": {{month}},\n  \"year\": {{year}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "if (pm.collectionVariables.get(\"authEnabled\") !== \"true\" && pm.environment.get(\"authEnabled\") !== \"true\") { pm.test(\"SKIPPED: auth is not enabled on this server (authEnabled=false)\", () => {}); return; }",
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong API key -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/schemes/current-month",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "schemes",
                "current-month"
              ]
            },
            "description": "",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "wrong-key"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dealer_code\": \"{{dealerCode}}\",\n  \"month\": {{month}},\n  \"year\": {{year}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "if (pm.collectionVariables.get(\"authEnabled\") !== \"true\" && pm.environment.get(\"authEnabled\") !== \"true\") { pm.test(\"SKIPPED: auth is not enabled on this server (authEnabled=false)\", () => {}); return; }",
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "SQL injection payload is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/schemes/current-month",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "schemes",
                "current-month"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
