                  "pm.test(\"Error lists what failed\", () => pm.expect(pm.response.json().detail).to.be.an(\"array\"));",
                  "pm.test(\"Input is not echoed back\", () => pm.expect(pm.response.text()).to.not.include(\"1' OR '1'='1\"));"
                ]
              }
            }
          ]
        },
