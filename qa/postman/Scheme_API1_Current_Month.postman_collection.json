{
  "info": {
    "_postman_id": "48c00caa-634f-5ed5-80a0-75316dc4c11e",
    "name": "Scheme API 1 - Monthly schemes",
    "description": "API 1: POST /v1/schemes/current-month with {dealer_code, month, year} returns the dealer's rows for the 8 template components in that month. month/year default to the current month (India time); set `month` and `year` in the environment to test another month.\n\n1. Import this collection and an environment (Local or Dev) from the same folder.\n2. Pick the environment, set `apiKey` if the server requires one.\n3. Run a request, or run the whole collection (Runner) to execute every test.\n\nFull guide: qa/README.md and docs/API_GUIDE.md in the repository.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const india = new Date(Date.now() + 5.5 * 3600 * 1000);",
          "if (!pm.environment.get(\"month\")) pm.collectionVariables.set(\"month\", india.getUTCMonth() + 1);",
          "if (!pm.environment.get(\"year\")) pm.collectionVariables.set(\"year\", india.getUTCFullYear());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responds within 2 seconds\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
          "pm.test(\"No stack trace or internal details in the body\", () => { const t = pm.response.text(); [\"Traceback\", \".py\\\"\", \"psycopg\", \"SELECT \"].forEach(s => pm.expect(t).to.not.include(s)); });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "api1RowCount",
      "value": ""
    },
    {
      "key": "month",
      "value": ""
    },
    {
      "key": "year",
      "value": ""
    }
  ],
